# Copy this file to .env and fill in one key. Never commit the real .env —
# .gitignore already excludes it.

# Portkey is the route used for this course. The model is reached through it.
PORTKEY_API_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to https://api.portkey.ai/v1
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional fallback if you are calling OpenAI directly rather than via Portkey.
# One of PORTKEY_API_KEY or OPENAI_API_KEY must be set.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. The default is the model this project was built and tested against.
# TNAT_MODEL=gpt-6-luna

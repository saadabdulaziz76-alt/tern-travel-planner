# the real key never leaves this machine
.env

# Account store: it holds password digests for anyone who signs up, so it is
# not committed. The server seeds test1 / test2 (password 12345678) on startup,
# so a fresh clone still has working demo logins with nothing secret in git.
data/accounts.json
data/accounts.tmp
data/accounts.corrupt.json

# token log — regenerated by running the app
data/usage_log.jsonl

backend/.venv/
__pycache__/
*.pyc
.DS_Store
web/_backup/

# video build intermediates — the finished mp4 is committed, the frames are not
demo/frames/
demo/verify/
demo/frames.txt
demo/durations.txt
demo/*.aiff
